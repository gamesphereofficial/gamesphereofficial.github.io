{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gamesphere",
  "pages_build_output_dir": "./dist",
  "compatibility_date": "2026-10-09",
  "vars": {
    "SITE_ORIGIN": "https://gamesphereofficial.github.io"
  },
  "r2_buckets": [
    {
      "binding": "GAMES_BUCKET",
      "bucket_name": "gamesphere-games"
    }
  ]
}
