{
  "name": "gamesphere",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "deploy:pages": "npm run build && wrangler pages deploy dist --project-name gamesphere",
    "deploy:game-host": "wrangler deploy --config wrangler.games.jsonc",
    "dev": "npm run build && wrangler pages dev dist",
    "test": "node --test"
  },
  "dependencies": {
    "@auth0/auth0-spa-js": "^2.3.0",
    "events": "^3.3.0",
    "fflate": "^0.8.2",
    "firebase": "^13.1.0",
    "lzma": "^2.3.2",
    "scratch-audio": "^2.0.275",
    "scratch-render": "^2.2.84",
    "scratch-storage": "^6.2.1",
    "scratch-vm": "^5.0.300"
  },
  "devDependencies": {
    "brfs": "^2.0.2",
    "buffer": "^6.0.3",
    "esbuild": "^0.25.0",
    "wrangler": "^4.40.0"
  },
  "overrides": {
    "hull.js": "git+https://github.com/andriiheonia/hull.git#9de6f9549b74fbb68bf4d5a449147b4c1d7cda0a"
  }
}
